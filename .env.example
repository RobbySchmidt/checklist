# Vorlage für .env – am einfachsten per `yarn setup --name <slug>` erzeugen lassen.

# Directus-Instanz, gegen die Nuxt rendert (geteilte Rhowerk-Instanz; Admin-Token nur für Skripte)
DIRECTUS_URL=http://localhost:8055
# Static Token eines Admin-Users – nur für scripts/ (Schema-Setup, Seeding)
DIRECTUS_ADMIN_TOKEN=
# Für MCP (Claude Code) – siehe .mcp.json.example
DIRECTUS_MCP_TOKEN=

# Öffentliche URL + Name der Website (Schema.org, Sitemap, Meta-Tags)
SITE_URL=http://localhost:3000
SITE_NAME=stellenpflege

# Auf Netlify ist SITE_NAME reserviert – dort stattdessen NUXT_PUBLIC_SITE_NAME setzen (hat Vorrang)
# NUXT_PUBLIC_SITE_NAME=Meine Website

# Nur für `yarn directus:copy` (scripts/copy-directus.mjs): Ziel-Instanz, in die Schema + Inhalte 1:1 kopiert werden
# REAL_DIRECTUS_URL=https://cms.example.com
# REAL_DIRECTUS_ADMIN_TOKEN=

EMPLOYER_SLUG=sonnenhof-leipzig
NOTIFY_BCC=
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=587
NUXT_MAIL_SECURE=false
NUXT_MAIL_USER=
NUXT_MAIL_PASS=
NUXT_MAIL_FROM=stellenpflege <noreply@example.com>
GOOGLE_SERVICE_ACCOUNT_JSON=
DIRECTUS_APP_TOKEN=
NUXT_SESSION_PASSWORD=
TASK_SECRET=
PORTAL_BASE_URL=

# Empfänger für Demo-Bewerbungen und Rhowerk-Admin-Login im Seed (eigene Adresse)
DEMO_EMAIL=

# Geteilte Ziel-Instanz (Umzug): Admin-Token nur für Schema-Skripte und yarn directus:copy, App-Token für den Betrieb.
# Betrieb gegen das Ziel: DIRECTUS_URL/DIRECTUS_APP_TOKEN auf diese Werte setzen.
# NEW_DIRECTUS_URL=https://cms.example.com
# NEW_DIRECTUS_TOKEN=
# NEW_DIRECTUS_APP_TOKEN=
