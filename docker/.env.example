# Vorlage für docker/.env – am einfachsten per `yarn setup --name <slug>` erzeugen lassen.
# Compose liest diese Datei automatisch (liegt neben docker-compose.yml).

# Compose-Projektname: eindeutig pro Projekt! Bestimmt Container- und Volume-Namen (<name>_database).
# Zwei Projekte mit demselben Namen teilen sich Container und Datenbank – und `down -v` im einen löscht die DB des anderen.
COMPOSE_PROJECT_NAME=

# Host-Ports / URLs – pro parallel laufendem Projekt anders wählen
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:3000

# DIRECTUS_SECRET: langer Zufallsstring, z. B. via `openssl rand -hex 32`
DIRECTUS_SECRET=bitte-64-zeichen-zufall-einsetzen

DB_USER=directus
DB_PASSWORD=bitte-passwort-setzen
DB_DATABASE=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-passwort-setzen
